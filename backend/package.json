{
  "name": "textfx-backend",
  "version": "0.2.0",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=18",
    "npm":  ">=9"
  },
  "scripts": {
    "dev":   "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "cors":    "^2.8.5",
    "dotenv":  "^16.4.5",
    "express": "^4.18.2",
    "openai":  "^4.47.1"
  },
  "devDependencies": {
    "@types/cors":    "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node":    "^20.0.0",
    "ts-node-dev":    "^2.0.0",
    "typescript":     "^5.4.5"
  }
}
